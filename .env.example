NEXT_PUBLIC_SITE_URL=https://hcmgloans.com

# Cloudflare Turnstile (create an Invisible widget for the production domain).
# Both values must be configured together. Without them, the other anti-spam
# controls remain active but Turnstile verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Goal Engine™ ─────────────────────────────────────────────
# Resend API key (already used for transactional emails)
RESEND_API_KEY=

# Shared secret for Zapier webhook — set a random string in Zapier too
ZAPIER_WEBHOOK_SECRET=

# Secret for weekly cron job (POST /api/goal-engine/weekly-email)
CRON_SECRET=

# ── SLICE ↔ ARIVE sync hooks ──────────────────────────────────────────
# "ARIVE HOURLY UPDATE" zap Catch Hook URL (loan-sync-cron posts loan_id list here)
ZAPIER_LOAN_SYNC_HOOK=
# "SLICE: Pull Applications Today" zap Catch Hook URL
ZAPIER_ARIVE_APPS_HOOK=
# "SLICE: Pull Fundings Today" zap Catch Hook URL
ZAPIER_ARIVE_FUNDED_HOOK=
