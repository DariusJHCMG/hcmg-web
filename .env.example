NEXT_PUBLIC_SITE_URL=https://hcmgloans.com

# Cloudflare Turnstile — widget 0x4AAAAAAFMLT04JwKFyOkJX
# Both keys are required for verification to be active.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is the browser-visible sitekey.
# TURNSTILE_SECRET_KEY is the server-side secret — never expose in NEXT_PUBLIC_.
# TURNSTILE_HOSTNAMES is a comma-separated list of hostnames the backend accepts
# in the siteverify response. Production value must NOT include localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFMLT04JwKFyOkJX
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=hcmgloans.com

# ── Goal Engine™ ─────────────────────────────────────────────
# Resend API key (already used for transactional emails)
RESEND_API_KEY=

# Shared secret for Zapier webhook — set a random string in Zapier too
ZAPIER_WEBHOOK_SECRET=

# Secret for weekly cron job (POST /api/goal-engine/weekly-email)
CRON_SECRET=

# ── SLICE ↔ ARIVE sync hooks ──────────────────────────────────────────
# "ARIVE HOURLY UPDATE" zap Catch Hook URL (loan-sync-cron posts loan_id list here)
ZAPIER_LOAN_SYNC_HOOK=
# "SLICE: Pull Applications Today" zap Catch Hook URL
ZAPIER_ARIVE_APPS_HOOK=
# "SLICE: Pull Fundings Today" zap Catch Hook URL
ZAPIER_ARIVE_FUNDED_HOOK=

# ── Starting Now Credit Repair Integration ─────────────────────────────
# API key issued by Starting Now (appended to their Zoho webhook URL as &zapikey=)
STARTING_NOW_API_KEY=
# Secret we generate — share with Starting Now for inbound webhook auth
# Generate with: openssl rand -hex 32
STARTING_NOW_WEBHOOK_SECRET=
